# igServer 환경설정. 이 파일을 .env 로 복사해서 쓰면 됩니다. (없어도 기본값으로 동작)

# 포트 / 바인딩
PORT=8787
HOST=0.0.0.0

# 관리자 계정 (최초 1회 생성). 운영에서는 반드시 바꾸세요.
ADMIN_EMAIL=admin@studio-ig.local
ADMIN_PASSWORD=admin1234

# DB 드라이버: 지정 없으면 sqlite(파일, 영속). 아래 DATABASE_URL 넣으면 PostgreSQL 자동 전환.
# DATABASE_URL=postgres://user:pass@host:5432/igserver
# DB_DRIVER=memory   # 데모/테스트용 (재시작 시 데이터 사라짐)

# JWT 시크릿 (지정 없으면 data/.jwt_secret 에 자동 생성)
# JWT_SECRET=
JWT_EXPIRES_IN=7d

# 파일 업로드 상한 (바이트, 기본 20MB)
MAX_UPLOAD_BYTES=20971520

# rate limit
RL_WINDOW_MS=60000
RL_MAX=300
RL_AUTH_MAX=20

# 감사로그 보존 기간(일). 0이면 영구 보관.
RETENTION_DAYS=0

# ---- 클러스터 (여러 대로 확장할 때만) ----
# MODE=standalone          # 기본: 혼자 전부 처리
# MODE=gateway             # 로드밸런서 겸 대표 노드
# MODE=worker              # 작업 노드 (라즈베리파이/PC)
# GATEWAY_URL=http://게이트웨이주소:8787   # worker가 등록할 게이트웨이
# SELF_URL=http://이노드주소:8787          # worker 자신의 주소
# NODE_LABEL=라즈베리1                      # 대시보드에 표시될 이름
# CLUSTER_SECRET=공유비밀값                  # 아무 노드나 등록 못하게 (선택)
